    "test:ui": "playwright test --project=ui",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.6",
    "@types/node": "24.3.0",
    "express": "^5.2.1",
    "prettier": "^3.6.2",
    "tsx": "^4.23.12",
    "typescript": "5.9.2"
  }
}
