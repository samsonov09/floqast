{
  "name": "senior-qe-take-home",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "tsx src/server.ts",
    "format:check": "prettier --check \"**/*.{ts,json,yml,md}\" --ignore-path .gitignore",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
